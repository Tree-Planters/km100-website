// Switch provider to "mysql" to use MySQL instead of PostgreSQL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PreRegistrationStatus {
  PENDING
  CONTACTED
  ENROLLED
  ARCHIVED
}

model PreRegistration {
  id String @id @default(cuid())

  referenceNumber String @unique
  status          PreRegistrationStatus @default(PENDING)

  firstName   String
  middleName  String?
  lastName    String
  suffix      String?
  civilStatus String?

  email      String
  mobile     String
  address      String?
  sitio        String?
  barangay     String?
  barangayCode String?
  district     String?
  municipality String?
  cityCode     String?
  province     String?
  provinceCode String?
  region       String?
  regionCode   String?

  isCurrentlyEnrolled String?
  currentSchool       String?
  currentGradeLevel   String?
  currentProgram      String?
  highestAttainment   String?

  acknowledgement Boolean @default(false)
  consent         Boolean @default(false)

  // Program slug, e.g. "computer-engineering-technology".
  program String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([program])
}
