// Switch provider to "mysql" to use MySQL instead of PostgreSQL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PreRegistrationStatus {
  PENDING
  CONTACTED
  ENROLLED
  ARCHIVED
}

model PreRegistration {
  id String @id @default(cuid())

  referenceNumber String @unique
  status          PreRegistrationStatus @default(PENDING)

  firstName   String
  middleName  String?
  lastName    String
  suffix      String?
  civilStatus String?
  sex         String?
  nationality String?

  // MIS 03-01 §3.3 - §3.5
  employmentStatus String?
  employmentType   String?
  birthMonth       Int?
  birthDay         Int?
  birthYear        Int?
  age              Int?
  birthCity        String?
  birthProvince    String?
  birthRegion      String?

  // MIS 03-01 §3.6 - §4
  educationalAttainment String?
  parentName            String?
  parentAddress         String?
  classification        String[]
  classificationOthers  String?

  // MIS 03-01 §8
  scholarshipPackage String?

  email      String
  mobile     String
  address      String?
  sitio        String?
  barangay     String?
  barangayCode String?
  district     String?
  municipality String?
  cityCode     String?
  province     String?
  provinceCode String?
  region       String?
  regionCode   String?

  // Derived from educationalAttainment; kept for existing exports/emails.
  isCurrentlyEnrolled String?
  currentSchool       String?
  currentGradeLevel   String?
  currentProgram      String?
  highestAttainment   String?

  acknowledgement Boolean @default(false)
  consent         Boolean @default(false)

  // Program slug, e.g. "computer-engineering-technology".
  program String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([program])
}
