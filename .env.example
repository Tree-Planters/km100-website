# Database (PostgreSQL by default — change the Prisma provider for MySQL)
DATABASE_URL="postgresql://user:password@localhost:5432/km100?schema=public"

# Email notifications (Resend)
RESEND_API_KEY=""
EMAIL_FROM="KM100 Website <no-reply@km100.example>"
SCHOOL_NOTIFICATION_EMAIL="km100skillsandtrainingcenter@gmail.com"

# Public site config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STUDENT_PORTAL_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""
# Google Maps setup:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project and enable the "Maps Embed API"
# 3. Get an embed URL from Google Maps (Share > Embed a map) or build one:
#    https://www.google.com/maps/embed/v1/place?key=YOUR_API_KEY&q=KM100+Skills+Training+Center+Bogo+City+Cebu
# 4. Paste the full embed URL above (no quotes needed around the value)
