# Database (Supabase PostgreSQL)
# Get these from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Email notifications (nodemailer over SMTP)
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and use that as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "true" for port 465 (implicit TLS); leave "false" for 587 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER="slmnconstantino@gmail.com"
SMTP_PASS=""
EMAIL_FROM="KM100 Skills and Training Center <slmnconstantino@gmail.com>"
SCHOOL_NOTIFICATION_EMAIL="km100skillsandtrainingcenter@gmail.com"

# Public site config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STUDENT_PORTAL_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""

# Admin Authentication
ADMIN_EMAIL="admin@km100.edu.ph"
ADMIN_PASSWORD="KM100AdminPassword2026!"
ADMIN_SESSION_SECRET="change-this-to-a-random-secret-in-production"
# Google Maps setup:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project and enable the "Maps Embed API"
# 3. Get an embed URL from Google Maps (Share > Embed a map) or build one:
#    https://www.google.com/maps/embed/v1/place?key=YOUR_API_KEY&q=KM100+Skills+Training+Center+Bogo+City+Cebu
# 4. Paste the full embed URL above (no quotes needed around the value)
